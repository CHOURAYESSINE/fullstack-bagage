{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "db",
        "namespace": "bagage"
      },
      "spec": {
        "type": "ClusterIP",
        "selector": {
          "app": "db"
        },
        "ports": [
          {
            "name": "tcp",
            "port": 5432,
            "targetPort": 5432,
            "protocol": "TCP"
          }
        ]
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "StatefulSet",
      "metadata": {
        "name": "db",
        "namespace": "bagage"
      },
      "spec": {
        "serviceName": "db",
        "replicas": 1,
        "selector": {
          "matchLabels": {
            "app": "db"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "db"
            }
          },
          "spec": {
            "automountServiceAccountToken": false,
            "securityContext": {
              "fsGroup": 999,
              "seccompProfile": {
                "type": "RuntimeDefault"
              }
            },
            "containers": [
              {
                "name": "db",
                "image": "postgres:16",
                "imagePullPolicy": "IfNotPresent",
                "securityContext": {
                  "runAsNonRoot": true,
                  "runAsUser": 999,
                  "runAsGroup": 999,
                  "allowPrivilegeEscalation": false,
                  "readOnlyRootFilesystem": true,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  }
                },
                "resources": {
                  "requests": {
                    "cpu": "50m",
                    "memory": "64Mi"
                  },
                  "limits": {
                    "cpu": "1000m",
                    "memory": "512Mi"
                  }
                },
                "envFrom": [
                  {
                    "secretRef": {
                      "name": "db-secret"
                    }
                  }
                ],
                "env": [
                  {
                    "name": "PGDATA",
                    "value": "/var/lib/postgresql/data/pgdata"
                  }
                ],
                "volumeMounts": [
                  {
                    "name": "data",
                    "mountPath": "/var/lib/postgresql/data"
                  },
                  {
                    "name": "tmp",
                    "mountPath": "/tmp"
                  },
                  {
                    "name": "run",
                    "mountPath": "/var/run/postgresql"
                  },
                  {
                    "name": "init",
                    "mountPath": "/docker-entrypoint-initdb.d/010-app-role.sh",
                    "subPath": "010-app-role.sh"
                  },
                  {
                    "name": "init",
                    "mountPath": "/setup/permissions.sql",
                    "subPath": "permissions.sql"
                  }
                ],
                "readinessProbe": {
                  "exec": {
                    "command": [
                      "pg_isready",
                      "-U",
                      "bagage_owner",
                      "-d",
                      "bagage"
                    ]
                  },
                  "initialDelaySeconds": 5,
                  "periodSeconds": 10,
                  "timeoutSeconds": 4,
                  "failureThreshold": 12
                }
              }
            ],
            "volumes": [
              {
                "name": "tmp",
                "emptyDir": {}
              },
              {
                "name": "run",
                "emptyDir": {}
              },
              {
                "name": "init",
                "configMap": {
                  "name": "db-init",
                  "defaultMode": 365
                }
              }
            ]
          }
        },
        "volumeClaimTemplates": [
          {
            "metadata": {
              "name": "data"
            },
            "spec": {
              "accessModes": [
                "ReadWriteOnce"
              ],
              "storageClassName": "local-path",
              "resources": {
                "requests": {
                  "storage": "2Gi"
                }
              }
            }
          }
        ]
      }
    }
  ]
}
