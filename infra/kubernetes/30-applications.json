{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "api",
        "namespace": "bagage"
      },
      "spec": {
        "type": "ClusterIP",
        "selector": {
          "app": "api"
        },
        "ports": [
          {
            "name": "tcp",
            "port": 8080,
            "targetPort": 8080,
            "protocol": "TCP"
          }
        ]
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "api",
        "namespace": "bagage"
      },
      "spec": {
        "replicas": 1,
        "strategy": {
          "type": "Recreate"
        },
        "selector": {
          "matchLabels": {
            "app": "api"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "api"
            }
          },
          "spec": {
            "automountServiceAccountToken": false,
            "securityContext": {
              "seccompProfile": {
                "type": "RuntimeDefault"
              }
            },
            "containers": [
              {
                "name": "api",
                "image": "fullstack-bagage-api:phase04",
                "imagePullPolicy": "IfNotPresent",
                "securityContext": {
                  "runAsNonRoot": true,
                  "runAsUser": 1654,
                  "runAsGroup": 1654,
                  "allowPrivilegeEscalation": false,
                  "readOnlyRootFilesystem": true,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  }
                },
                "resources": {
                  "requests": {
                    "cpu": "50m",
                    "memory": "64Mi"
                  },
                  "limits": {
                    "cpu": "1000m",
                    "memory": "512Mi"
                  }
                },
                "envFrom": [
                  {
                    "secretRef": {
                      "name": "api-secret"
                    }
                  }
                ],
                "env": [
                  {
                    "name": "ASPNETCORE_ENVIRONMENT",
                    "value": "Production"
                  },
                  {
                    "name": "ASPNETCORE_HTTP_PORTS",
                    "value": "8080"
                  }
                ],
                "volumeMounts": [
                  {
                    "name": "tmp",
                    "mountPath": "/tmp"
                  }
                ],
                "readinessProbe": {
                  "httpGet": {
                    "path": "/health/ready",
                    "port": 8080
                  },
                  "periodSeconds": 5
                },
                "livenessProbe": {
                  "httpGet": {
                    "path": "/health/live",
                    "port": 8080
                  },
                  "periodSeconds": 15,
                  "initialDelaySeconds": 20
                }
              }
            ],
            "volumes": [
              {
                "name": "tmp",
                "emptyDir": {}
              }
            ]
          }
        }
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "public",
        "namespace": "bagage"
      },
      "spec": {
        "replicas": 1,
        "strategy": {
          "type": "Recreate"
        },
        "selector": {
          "matchLabels": {
            "app": "public"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "public"
            }
          },
          "spec": {
            "automountServiceAccountToken": false,
            "securityContext": {
              "seccompProfile": {
                "type": "RuntimeDefault"
              },
              "fsGroup": 101
            },
            "containers": [
              {
                "name": "public",
                "image": "fullstack-bagage-public:latest",
                "imagePullPolicy": "IfNotPresent",
                "securityContext": {
                  "runAsNonRoot": true,
                  "runAsUser": 101,
                  "runAsGroup": 101,
                  "allowPrivilegeEscalation": false,
                  "readOnlyRootFilesystem": true,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  }
                },
                "resources": {
                  "requests": {
                    "cpu": "50m",
                    "memory": "64Mi"
                  },
                  "limits": {
                    "cpu": "1000m",
                    "memory": "512Mi"
                  }
                },
                "volumeMounts": [
                  {
                    "name": "tmp",
                    "mountPath": "/tmp"
                  },
                  {
                    "name": "config",
                    "mountPath": "/etc/nginx/conf.d/default.conf",
                    "subPath": "default.conf"
                  },
                  {
                    "name": "tls",
                    "mountPath": "/tls"
                  }
                ],
                "readinessProbe": {
                  "exec": {
                    "command": [
                      "wget",
                      "-q",
                      "-O",
                      "/dev/null",
                      "http://127.0.0.1:8080/healthz"
                    ]
                  },
                  "initialDelaySeconds": 5,
                  "periodSeconds": 10,
                  "timeoutSeconds": 4,
                  "failureThreshold": 12
                }
              }
            ],
            "volumes": [
              {
                "name": "tmp",
                "emptyDir": {}
              },
              {
                "name": "config",
                "configMap": {
                  "name": "public-nginx"
                }
              },
              {
                "name": "tls",
                "secret": {
                  "secretName": "public-tls",
                  "defaultMode": 288
                }
              }
            ]
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "public",
        "namespace": "bagage"
      },
      "spec": {
        "type": "NodePort",
        "selector": {
          "app": "public"
        },
        "ports": [
          {
            "name": "tcp",
            "port": 8443,
            "targetPort": 8443,
            "protocol": "TCP",
            "nodePort": 31443
          }
        ]
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "agents",
        "namespace": "bagage"
      },
      "spec": {
        "replicas": 1,
        "strategy": {
          "type": "Recreate"
        },
        "selector": {
          "matchLabels": {
            "app": "agents"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "agents"
            }
          },
          "spec": {
            "automountServiceAccountToken": false,
            "securityContext": {
              "seccompProfile": {
                "type": "RuntimeDefault"
              },
              "fsGroup": 101
            },
            "containers": [
              {
                "name": "agents",
                "image": "fullstack-bagage-agents:latest",
                "imagePullPolicy": "IfNotPresent",
                "securityContext": {
                  "runAsNonRoot": true,
                  "runAsUser": 101,
                  "runAsGroup": 101,
                  "allowPrivilegeEscalation": false,
                  "readOnlyRootFilesystem": true,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  }
                },
                "resources": {
                  "requests": {
                    "cpu": "50m",
                    "memory": "64Mi"
                  },
                  "limits": {
                    "cpu": "1000m",
                    "memory": "512Mi"
                  }
                },
                "volumeMounts": [
                  {
                    "name": "tmp",
                    "mountPath": "/tmp"
                  },
                  {
                    "name": "config",
                    "mountPath": "/etc/nginx/conf.d/default.conf",
                    "subPath": "default.conf"
                  },
                  {
                    "name": "tls",
                    "mountPath": "/tls"
                  },
                  {
                    "name": "config",
                    "mountPath": "/usr/share/nginx/html/segment.json",
                    "subPath": "segment.json"
                  }
                ],
                "readinessProbe": {
                  "exec": {
                    "command": [
                      "wget",
                      "-q",
                      "-O",
                      "/dev/null",
                      "http://127.0.0.1:8080/healthz"
                    ]
                  },
                  "initialDelaySeconds": 5,
                  "periodSeconds": 10,
                  "timeoutSeconds": 4,
                  "failureThreshold": 12
                }
              }
            ],
            "volumes": [
              {
                "name": "tmp",
                "emptyDir": {}
              },
              {
                "name": "config",
                "configMap": {
                  "name": "agents-nginx"
                }
              },
              {
                "name": "tls",
                "secret": {
                  "secretName": "agents-tls",
                  "defaultMode": 288
                }
              },
              {
                "name": "wg",
                "secret": {
                  "secretName": "wireguard-server",
                  "defaultMode": 256
                }
              },
              {
                "name": "setup",
                "configMap": {
                  "name": "vpn-init",
                  "defaultMode": 365
                }
              }
            ],
            "initContainers": [
              {
                "name": "wireguard",
                "image": "fullstack-bagage-network-tools:latest",
                "imagePullPolicy": "IfNotPresent",
                "command": [
                  "sh",
                  "/setup/setup.sh"
                ],
                "securityContext": {
                  "runAsUser": 0,
                  "allowPrivilegeEscalation": false,
                  "readOnlyRootFilesystem": true,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ],
                    "add": [
                      "NET_ADMIN"
                    ]
                  }
                },
                "volumeMounts": [
                  {
                    "name": "wg",
                    "mountPath": "/wireguard"
                  },
                  {
                    "name": "setup",
                    "mountPath": "/setup"
                  },
                  {
                    "name": "tmp",
                    "mountPath": "/tmp"
                  }
                ]
              }
            ]
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "agents",
        "namespace": "bagage"
      },
      "spec": {
        "type": "ClusterIP",
        "selector": {
          "app": "agents"
        },
        "ports": [
          {
            "name": "tcp",
            "port": 8443,
            "targetPort": 8443,
            "protocol": "TCP"
          }
        ]
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "wireguard",
        "namespace": "bagage"
      },
      "spec": {
        "type": "NodePort",
        "selector": {
          "app": "agents"
        },
        "ports": [
          {
            "name": "udp",
            "port": 51820,
            "targetPort": 51820,
            "protocol": "UDP",
            "nodePort": 31820
          }
        ]
      }
    }
  ]
}
