# Copier en .env ; remplacer les valeurs avant le démarrage. Ne jamais committer .env.
POSTGRES_PASSWORD=replace-with-a-random-owner-password
BAGAGE_APP_PASSWORD=replace-with-a-different-random-password
JWT_KEY=replace-with-at-least-32-random-bytes
BOOTSTRAP_LOGIN=admin.local
BOOTSTRAP_PASSWORD=replace-with-a-strong-unique-password

# Port Docker local ; modifier si Windows le réserve.
API_PORT=18080
